# EmployLabs marketing site (employlabs.ai) -- environment template.
# Copy to .env.local for local work. .env* is gitignored except this file.

# Google Analytics 4 measurement id.
#
# MUST be set in Vercel project settings (Production environment only) -- it is
# not hardcoded in the repo and there is no fallback. Leave it UNSET for Preview
# and Development environments so preview/local traffic never pollutes
# production reporting: when it is absent or does not match /^G-[A-Z0-9]+$/ the
# app renders no script tag and makes no request to Google.
#
# This is the SAME id the app at app.employlabs.ai uses, on purpose:
# employlabs.ai and app.employlabs.ai share a root domain and belong to one GA4
# property, so a visitor who lands here and then signs in stays one session and
# one journey. Do not create a second property or a second data stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KEVEJ1JSJK
